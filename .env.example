# Discord configuration (RPG Chat bot)
DISCORD_TOKEN=your-discord-bot-token

# OpenAI (ChatGPT) configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_INSTRUCTIONS=You are a helpful assistant.

# Optional RAG settings (see README.md)
OPENAI_VECTOR_STORE_ID=
OPENAI_VECTOR_STORE_NAME=rpg-chat-knowledge-base

# Web frontend (web-server.js) — port it listens on. NGINX on proxy02
# reverse-proxies to this. See nginx/proxy02-rpgchat.conf.
WEB_PORT=3001

# Optional shared password for the web frontend. Leave blank to run with
# no password (e.g. if you're using NGINX auth_basic instead, or just
# testing locally). If set, visitors see a login screen before they can
# chat.
SITE_PASSWORD=
